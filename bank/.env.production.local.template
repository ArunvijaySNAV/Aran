# Tessera Bank: production environment (Vercel + hosted Supabase + Aran behind a tunnel).
# Copy this file to bank/.env.production.local, fill in the values in your editor and keep it out of git
# (bank/.env.production.local is ignored; this template is the only committed copy and holds names, never values).
# Where to obtain each value and where it is used: docs/SECRETS_CHECKLIST.md

# --- Supabase (hosted project) ---
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aran Cloud (the public address of your tunnel, and the two keys minted for the bank) ---
ARAN_BASE_URL=
ARAN_APP_KEY=
ARAN_COMPLIANCE_KEY=

# --- Encrypts the Aran keys saved from the admin "Aran connection" page: 32 random bytes as 64 hex characters (openssl rand -hex 32) ---
CONNECTION_ENC_KEY=

# --- Only for seeding the hosted staff users from your machine (not set on Vercel) ---
SEED_STAFF_PASSWORD=
